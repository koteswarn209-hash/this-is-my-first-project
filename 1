terraform {
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = "your-gcp-project-id"
  region  = "asia-south1"
}

resource "google_storage_bucket" "my_bucket" {
  name     = "my-unique-bucket-name-12345678"
  location = "ASIA-SOUTH1"

  uniform_bucket_level_access = true
}
